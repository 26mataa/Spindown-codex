---
import Base from '../layouts/Base.astro';
import { formatId, visibleItems } from '../lib/chain';
import { url } from '../lib/urls';

// Le haut de la chaîne : c'est le point d'entrée, pas une sélection arbitraire.
const preview = [...visibleItems].reverse().slice(0, 12);
---

<Base title="Spindown Codex — The Binding of Isaac item chain">
  <section class="opening">
    <div class="wrap">
      <h1 class="wordmark">Spindown <span>Codex</span></h1>

      <p class="tagline" data-i18n-html="home.lede">
        Every collectible in <em>Repentance+</em>, and what each one becomes with a Spindown Dice.
      </p>

      <div class="find" data-search-root>
        <label class="visually-hidden" for="q" data-i18n="home.searchPlaceholder">
          Search any item, in any language
        </label>
        <input
          id="q"
          type="search"
          name="q"
          placeholder="Search an item — in any of 20 languages…"
          autocomplete="off"
          spellcheck="false"
          data-search-input
          data-i18n-placeholder="home.searchPlaceholder"
        />
        <ul class="results" data-search-results hidden></ul>
      </div>

      <p class="hint" data-i18n="home.searchHint">
        Try “Brim”, “Oignon Triste”, “悲しみオニオン”, “Кубик с вычетом”.
      </p>
    </div>
  </section>

  <section class="wrap down" aria-labelledby="down-title">
    <div class="down__head">
      <h2 id="down-title" data-i18n="chain.title">The chain</h2>
      <a class="down__link" href={url('/chain')} data-i18n="item.seeChain">See the whole chain →</a>
    </div>

    <ol class="spine">
      {
        preview.map((item) => (
          <li class="spine__row">
            <a class="spine__link" href={url(`/items/${item.id}`)}>
              <span class="spine__id mono">{formatId(item.id)}</span>
              <span class="spine__art">
                <img src={item.icon} alt="" width="26" height="26" loading="lazy" decoding="async" />
              </span>
              <span class="spine__name">{item.name}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="down__more">
      <a href={url('/items')} data-i18n="chain.footBrowse" data-i18n-args={JSON.stringify({ n: visibleItems.length })}
        >Browse all {visibleItems.length} items</a
      >
    </p>
  </section>
</Base>

<script>
  import { url } from '../lib/urls';
  import { buildIndex, search, type Row, type SearchEntry } from '../lib/search';

  const root = document.querySelector<HTMLElement>('[data-search-root]');
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
  const list = root?.querySelector<HTMLUListElement>('[data-search-results]');

  let index: SearchEntry[] | null = null;
  let loading: Promise<void> | null = null;

  async function load() {
    if (index) return;
    loading ??= fetch(url('/search.json'))
      .then((r) => r.json())
      .then((rows: Row[]) => {
        index = buildIndex(rows);
      });
    await loading;
  }

  function lookup(q: string) {
    return index ? search(index, q) : [];
  }

  function render(results: { id: number; name: string }[]) {
    if (!list) return;
    if (!results.length) {
      list.hidden = true;
      list.innerHTML = '';
      return;
    }
    list.innerHTML = results
      .map((r) => {
        const href = url(`/items/${r.id}`);
        const src = url(`/icons/${r.id}.png`);
        return `<li><a href="${href}"><img src="${src}" alt="" width="26" height="26" loading="lazy"><span>${r.name}</span><span class="mono">#${String(r.id).padStart(3, '0')}</span></a></li>`;
      })
      .join('');
    list.hidden = false;
  }

  if (input && list) {
    input.addEventListener('focus', () => void load());
    input.addEventListener('input', () => {
      if (!index) {
        void load().then(() => render(lookup(input.value)));
        return;
      }
      render(lookup(input.value));
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.blur();
        render([]);
      }
      if (e.key === 'Enter') {
        const first = list.querySelector('a');
        if (first) location.href = first.getAttribute('href')!;
      }
    });
    document.addEventListener('click', (e) => {
      if (!root?.contains(e.target as Node)) render([]);
    });

    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      void load().then(() => render(lookup(initial)));
    }
  }
</script>

<style>
  .opening {
    padding-block: clamp(3rem, 12vh, 7rem) clamp(2.5rem, 7vh, 4rem);
  }

  .wordmark {
    font-size: clamp(2.6rem, 7.5vw, 4.8rem);
    line-height: 0.98;
    margin: 0 0 1.1rem;
    letter-spacing: -0.01em;
  }

  .wordmark span {
    background: linear-gradient(180deg, #ffffff 5%, #a9eefa 45%, #38bcd6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    max-width: 44ch;
    margin: 0 0 2.4rem;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    color: var(--ink-dim);
  }

  .tagline :global(em) {
    color: var(--ink);
    font-style: italic;
  }

  /* Le champ de recherche : une ligne, pas un widget. */
  .find {
    position: relative;
    max-width: 34rem;
  }

  .find input {
    width: 100%;
    padding: 0.55rem 0 0.6rem;
    font: inherit;
    font-size: clamp(1.05rem, 2.3vw, 1.4rem);
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(190, 240, 250, 0.25);
    outline: none;
    transition: border-color var(--dur) var(--ease);
  }

  .find input::placeholder {
    color: var(--ink-faint);
  }

  .find input:focus {
    border-bottom-color: var(--aqua);
  }

  .hint {
    margin: 0.75rem 0 0;
    font-size: 0.76rem;
    color: var(--ink-faint);
  }

  /* --- la descente --- */

  .down {
    padding-bottom: 3rem;
  }

  .down__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .down__head h2 {
    margin: 0;
    font-size: 1.15rem;
    color: var(--ink-dim);
  }

  .down__link {
    font-size: 0.82rem;
    color: var(--ink-faint);
    text-decoration: none;
    white-space: nowrap;
  }

  .down__link:hover {
    color: var(--aqua);
  }

  .down__more {
    margin: 1rem 0 0;
    font-size: 0.82rem;
  }

  .down__more a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .down__more a:hover {
    color: var(--aqua);
  }

  /* --- résultats --- */

  .results {
    position: absolute;
    z-index: 30;
    inset-inline: 0;
    top: calc(100% + 0.4rem);
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    border-radius: var(--r-sm);
    background: linear-gradient(180deg, rgba(11, 47, 60, 0.98), rgba(4, 20, 27, 0.98));
    border: 1px solid var(--edge);
    box-shadow: 0 24px 48px -20px #000, inset 0 1px 0 var(--spec);
    backdrop-filter: blur(10px);
  }

  :global(.results a) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.5rem;
    border-radius: 7px;
    color: var(--ink);
    text-decoration: none;
  }

  :global(.results a:hover),
  :global(.results a:focus-visible) {
    background: rgba(79, 216, 232, 0.14);
  }

  :global(.results img) {
    image-rendering: pixelated;
  }

  :global(.results .mono) {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  @media (max-width: 720px) {
    .down__head {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
