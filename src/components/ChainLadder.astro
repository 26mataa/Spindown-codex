---
import { ancestorsOf, byId, descendantsOf, formatId, spindownTarget } from '../lib/chain';
import { url } from '../lib/urls';

export interface Props {
  id: number;
  /** Nombre de voisins affiches de chaque cote. */
  depth?: number;
}

const { id, depth = 5 } = Astro.props;

const up = ancestorsOf(id, depth).reverse(); // du plus eloigne au plus proche
const down = descendantsOf(id, depth);

const rows = [
  ...up.map((nid, i) => ({ nid, distance: up.length - i, dir: 'up' as const })),
  ...down.map((nid, i) => ({ nid, distance: i + 1, dir: 'down' as const })),
];

const current = byId.get(id)!;
const next = spindownTarget(id);
const chainEndsHere = next === null && !!current.spindown.blocked;
const isTop = !up.length;
---

<nav class="ladder" aria-label={`Items around ${current.name} in the Spindown chain`}>
  <ol class="ladder__list">
    {
      rows
        .filter((r) => r.dir === 'up')
        .map((r) => {
          const it = byId.get(r.nid)!;
          return (
            <li class="ladder__row ladder__row--up" style={`--dist:${r.distance}`}>
              <a href={url(`/items/${it.id}`)} class="ladder__link">
                <img src={it.icon} alt="" width="32" height="32" loading="lazy" decoding="async" />
                <span class="ladder__name">{it.name}</span>
                <span class="ladder__id mono">{formatId(it.id)}</span>
              </a>
            </li>
          );
        })
    }

    <li class="ladder__row ladder__row--current" aria-current="true">
      <span class="ladder__link ladder__link--current">
        <img src={current.icon} alt="" width="32" height="32" decoding="async" />
        <span class="ladder__name">{current.name}</span>
        <span class="ladder__id mono">{formatId(current.id)}</span>
      </span>
    </li>

    {
      rows
        .filter((r) => r.dir === 'down')
        .map((r) => {
          const it = byId.get(r.nid)!;
          return (
            <li class="ladder__row ladder__row--down" style={`--dist:${r.distance}`}>
              <a href={url(`/items/${it.id}`)} class="ladder__link">
                <img src={it.icon} alt="" width="32" height="32" loading="lazy" decoding="async" />
                <span class="ladder__name">{it.name}</span>
                <span class="ladder__id mono">{formatId(it.id)}</span>
              </a>
            </li>
          );
        })
    }
  </ol>

  {
    chainEndsHere && (
      <p class="ladder__stop">
        <span aria-hidden="true">✖</span>{' '}
        <span
          data-i18n="item.chainStops"
          data-i18n-args={JSON.stringify({ name: current.name })}>The chain stops here — {current.name} cannot be rerolled.</span
        >
      </p>
    )
  }

  {
    isTop && (
      <p
        class="ladder__stop ladder__stop--calm"
        data-i18n="item.chainTop"
        data-i18n-args={JSON.stringify({ id: formatId(current.id) })}
      >
        Top of the chain: nothing can Spindown into {formatId(current.id)}.
      </p>
    )
  }
</nav>

<style>
  .ladder {
    position: relative;
    padding-left: 1.2rem;
  }

  .ladder__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    position: relative;
  }

  .ladder__list::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(79, 216, 232, 0.5) 14%,
      rgba(79, 216, 232, 0.7) 50%,
      rgba(79, 216, 232, 0.4) 86%,
      transparent
    );
  }

  .ladder__row {
    position: relative;
    opacity: max(0.4, calc(1 - (var(--dist, 0) * 0.1)));
  }

  .ladder__row::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 50%;
    width: 0.85rem;
    height: 1px;
    background: rgba(79, 216, 232, 0.28);
  }

  .ladder__link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.28rem 0.55rem;
    border-radius: 10px;
    border: 1px solid transparent;
    color: var(--ink-dim);
    text-decoration: none;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .ladder__link img {
    image-rendering: pixelated;
    flex: none;
    border-radius: 6px;
    background: radial-gradient(circle at 50% 32%, #10404e, #04141c 78%);
  }

  .ladder__link:hover,
  .ladder__link:focus-visible {
    background: rgba(190, 240, 250, 0.1);
    border-color: var(--edge-soft);
    color: var(--ink);
  }

  .ladder__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ladder__id {
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--ink-faint);
  }

  .ladder__row--current {
    opacity: 1;
    margin-block: 0.3rem;
  }

  .ladder__row--current::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 0;
    bottom: 0;
    width: 2px;
    height: auto;
    background: linear-gradient(180deg, #9beeff, #2aa8c4);
    box-shadow: 0 0 12px rgba(79, 216, 232, 0.8);
  }

  .ladder__link--current {
    background: linear-gradient(180deg, rgba(79, 216, 232, 0.2), rgba(79, 216, 232, 0.05));
    border-color: rgba(79, 216, 232, 0.55);
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .ladder__stop {
    margin: 0.9rem 0 0;
    padding: 0.5rem 0.75rem;
    font-size: 0.83rem;
    border-radius: 10px;
    color: #ffc9c3;
    border: 1px solid rgba(208, 69, 60, 0.45);
    background: linear-gradient(180deg, rgba(208, 69, 60, 0.18), rgba(208, 69, 60, 0.05));
  }

  .ladder__stop--calm {
    color: var(--ink-dim);
    border-color: var(--edge-soft);
    background: rgba(0, 0, 0, 0.2);
  }
</style>
