---
import '../styles/global.css';
import { LANGS, LANG_NAMES } from '../i18n/dict';
import { BASE, url } from '../lib/urls';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A free, ad-free fan encyclopedia for The Binding of Isaac: Repentance+, built around the Spindown Dice chain.',
} = Astro.props;

const path = Astro.url.pathname.startsWith(BASE) ? Astro.url.pathname.slice(BASE.length) || '/' : Astro.url.pathname;
const nav = [
  { href: '/items', label: 'nav.items' },
  { href: '/chain', label: 'nav.chain' },
  { href: '/calculator', label: 'nav.calculator' },
  { href: '/credits', label: 'nav.credits' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

const fonts = `
@font-face{font-family:'Pixelify Sans';src:url('${url('/fonts/pixelify-sans.woff2')}') format('woff2');font-display:swap;font-weight:400 700;}
@font-face{font-family:'IBM Plex Sans';src:url('${url('/fonts/ibm-plex-sans-400.woff2')}') format('woff2');font-display:swap;font-weight:400;font-style:normal;}
@font-face{font-family:'IBM Plex Sans';src:url('${url('/fonts/ibm-plex-sans-600.woff2')}') format('woff2');font-display:swap;font-weight:600 700;font-style:normal;}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={url('/icons/723.png')} />
    <link rel="preload" href={url('/fonts/pixelify-sans.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/ibm-plex-sans-400.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fonts}></style>
    <meta name="theme-color" content="#120c0c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n="common.skip">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url('/')}>
          <img src={url('/icons/723.png')} alt="" width="32" height="32" />
          Spindown <span>Codex</span>
        </a>
        <nav class="nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined} data-i18n={item.label}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="lang">
          <label class="visually-hidden" for="lang-select" data-i18n="common.language">Language</label>
          <select id="lang-select" data-lang-select>
            {
              LANGS.map((code) => (
                <option value={code}>{LANG_NAMES[code]}</option>
              ))
            }
          </select>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div>
          <p data-i18n="footer.disclaimer">
            Unofficial fan project, not affiliated with Edmund McMillen, Nicalis or Valve.
          </p>
          <p data-i18n="footer.free">Free site, no ads, no monetization, no accounts, no tracking.</p>
        </div>
        <div>
          <p><a href={url('/credits')} data-i18n="footer.credits">Credits &amp; legal</a></p>
          <p class="faint" data-i18n="footer.sprites">Sprites © Edmund McMillen / Nicalis.</p>
        </div>
      </div>
    </footer>

    <script>
      import { initI18n } from '../i18n/runtime';
      initI18n();
    </script>
  </body>
</html>

<style>
  .lang {
    display: flex;
    align-items: center;
    margin-left: 0.3rem;
  }

  .lang select {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.22rem 0.35rem;
    color: var(--ink-dim);
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .lang select:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .lang select:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .nav {
      order: 3;
      width: 100%;
      margin-left: 0;
    }
  }
</style>
