---
/**
 * Contexte de chaîne d'une fiche : la descente uniquement.
 *
 * On part de l'item courant et on descend jusqu'à The Sad Onion. Les items
 * affichés au-dessus (IDs supérieurs) ne servaient à rien : un Spindown ne va
 * que vers le bas, on ne peut pas les atteindre depuis ici. L'item qui mène à
 * celui-ci est déjà indiqué dans le panneau « Spindown Dice ».
 *
 * La suite de la descente est chargée à la demande depuis /chain.json, pour ne
 * pas embarquer 700 lignes dans chacune des 717 fiches.
 */
import { byId, descendantsOf, formatId } from '../lib/chain';
import { url } from '../lib/urls';

export interface Props {
  id: number;
  /** Nombre de descendants rendus côté serveur. */
  depth?: number;
}

const { id, depth = 24 } = Astro.props;

const current = byId.get(id)!;
const down = descendantsOf(id, depth);
---

<div class="ladder">
  <span class="visually-hidden" data-ladder-flag data-i18n="item.noReroll">cannot be rerolled</span>

  <p class="ladder__legend">
    <span class="ladder__arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M12 4v15" />
        <path d="m5 12 7 7 7-7" />
      </svg>
    </span>
    <span data-i18n="item.chainDir">Spindown flows down: each item becomes the one below it.</span>
    <span class="ladder__hint mono" aria-hidden="true">↕</span>
  </p>

  <div
    class="ladder__scroll"
    data-ladder-scroll
    data-ladder-id={id}
    tabindex="0"
    role="group"
    aria-label="Spindown descent"
  >
    <ol class="ladder__list" data-ladder-list>
      <li class="ladder__row ladder__row--current" aria-current="true" data-current>
        <span class="ladder__link ladder__link--current">
          <img src={current.icon} alt="" width="30" height="30" decoding="async" />
          <span class="ladder__name">{current.name}</span>
          <span class="ladder__id mono">{formatId(current.id)}</span>
        </span>
      </li>

      {
        down.map((nid, i) => {
          const it = byId.get(nid)!;
          const blocked = Boolean(it.spindown.blocked);
          return (
            <li
              class:list={['ladder__row', { 'ladder__row--blocked': blocked }]}
              style={`--dist:${i + 1}`}
              data-id={it.id}
            >
              <a href={url(`/items/${it.id}`)} class="ladder__link">
                <img src={it.icon} alt="" width="30" height="30" loading="lazy" decoding="async" />
                <span class="ladder__name">{it.name}</span>
                {blocked && (
                  <span class="ladder__flag" data-i18n="item.noReroll">
                    cannot be rerolled
                  </span>
                )}
                <span class="ladder__id mono">{formatId(it.id)}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</div>

<script>
  import { url } from '../lib/urls';

  /** [id, nom, bloque] — voir scripts/build-data.mjs. */
  type ChainRow = [number, string, number];

  let chainPromise: Promise<ChainRow[]> | null = null;
  const loadChain = (): Promise<ChainRow[]> => {
    chainPromise ??= fetch(url('/chain.json')).then((r) => r.json() as Promise<ChainRow[]>);
    return chainPromise;
  };

  const flagLabel =
    document.querySelector('[data-ladder-flag]')?.textContent?.trim() ?? 'cannot be rerolled';

  const BATCH = 40;

  /**
   * Astro scope ses styles avec un attribut data-astro-cid-*. Les elements
   * crees en JS naissent sans cet attribut : sans cette copie, les lignes
   * ajoutees au defilement s'affichent sans style (texte colle, pas de badge).
   */
  const scopeFrom = (source: Element | null): ((el: Element) => void) => {
    const attrs = source
      ? Array.from(source.attributes).filter((a) => a.name.startsWith('data-astro-cid-'))
      : [];
    return (el: Element) => {
      for (const attr of attrs) el.setAttribute(attr.name, attr.value);
    };
  };

  for (const box of document.querySelectorAll<HTMLElement>('[data-ladder-scroll]')) {
    const list = box.querySelector<HTMLOListElement>('[data-ladder-list]');
    const id = Number(box.dataset.ladderId);
    if (!list || !Number.isFinite(id)) continue;

    const scoped = scopeFrom(list.querySelector('.ladder__row'));

    let chain: ChainRow[] | null = null;
    let baseIndex = -1;
    let cursor = -1;
    let done = false;
    let loading = false;

    const makeRow = (
      itemId: number,
      name: string,
      blocked: boolean,
      distance: number
    ): HTMLLIElement => {
      const li = document.createElement('li');
      li.className = blocked ? 'ladder__row ladder__row--blocked' : 'ladder__row';
      li.dataset.id = String(itemId);
      li.style.setProperty('--dist', String(Math.min(distance, 60)));
      scoped(li);

      const a = document.createElement('a');
      a.className = 'ladder__link';
      a.href = url(`/items/${itemId}`);

      const img = document.createElement('img');
      img.src = url(`/icons/${itemId}.png`);
      img.alt = '';
      img.width = 30;
      img.height = 30;
      img.loading = 'lazy';
      img.decoding = 'async';

      const label = document.createElement('span');
      label.className = 'ladder__name';
      label.textContent = name;

      scoped(a);
      scoped(img);
      scoped(label);
      a.append(img, label);

      if (blocked) {
        const flag = document.createElement('span');
        flag.className = 'ladder__flag';
        flag.textContent = flagLabel;
        scoped(flag);
        a.append(flag);
      }

      const code = document.createElement('span');
      code.className = 'ladder__id mono';
      code.textContent = `#${String(itemId).padStart(3, '0')}`;
      scoped(code);
      a.append(code);

      li.append(a);
      return li;
    };

    const appendNext = () => {
      if (!chain || done) return;
      const start = cursor + 1;
      const slice = chain.slice(start, start + BATCH);
      if (!slice.length) {
        done = true;
        return;
      }

      const frag = document.createDocumentFragment();
      let appended = 0;

      for (let i = 0; i < slice.length; i++) {
        const [itemId, name, blocked] = slice[i];
        frag.appendChild(makeRow(itemId, name, Boolean(blocked), start + i - baseIndex));
        appended++;

        // La descente s'arrête sur un item non rerollable : exactement comme
        // côté serveur, on ne va pas plus loin.
        if (blocked) {
          done = true;
          break;
        }
      }

      list.appendChild(frag);
      cursor = start + appended - 1;
      if (cursor >= chain.length - 1) done = true;
    };

    const ensureChain = async () => {
      if (chain || loading) return;
      loading = true;
      chain = await loadChain();
      baseIndex = chain.findIndex(([itemId]) => itemId === id);

      if (baseIndex < 0) {
        done = true;
        loading = false;
        return;
      }

      // Le serveur a déjà rendu les premiers descendants : on cale le curseur
      // sur le dernier d'entre eux.
      cursor = baseIndex + list.querySelectorAll('.ladder__row').length - 1;

      // Le dernier item rendu est déjà bloquant : il n'y a rien après.
      if (chain[cursor]?.[2]) done = true;
      loading = false;
    };

    const maybeLoad = () => {
      if (done || loading) return;
      if (box.scrollTop + box.clientHeight >= box.scrollHeight - 240) {
        if (chain) appendNext();
        else void ensureChain().then(appendNext);
      }
    };

    box.addEventListener('scroll', maybeLoad, { passive: true });

    // Si le contenu rendu est déjà plus court que le cadre, aucun scroll n'est
    // possible : on complète immédiatement.
    if (box.scrollHeight <= box.clientHeight + 8) {
      void ensureChain().then(appendNext);
    }
  }
</script>

<style>
  .ladder {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .ladder__legend {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.76rem;
    color: var(--ink-faint);
  }

  .ladder__hint {
    margin-left: auto;
    font-size: 0.85rem;
    color: rgba(227, 155, 84, 0.8);
    letter-spacing: -0.05em;
  }

  .ladder__arrow {
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
    border-radius: 50%;
    color: #2a1705;
    background: linear-gradient(180deg, #fde3ca, #e09c59);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 0 12px rgba(227, 155, 84, 0.5);
  }

  /* La fenêtre sur la descente : elle défile, la page non. */
  .ladder__scroll {
    position: relative;
    max-height: 21rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.35rem 0;
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(19, 11, 3, 0.45), rgba(19, 11, 3, 0.2));
    box-shadow: inset 0 2px 14px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(248, 220, 192, 0.08);
    scrollbar-width: thin;
    scrollbar-color: rgba(227, 155, 84, 0.75) rgba(255, 255, 255, 0.07);
  }

  .ladder__scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ladder__list {
    list-style: none;
    margin: 0;
    padding: 0.2rem 0.55rem 0.2rem 1.85rem;
    position: relative;
  }

  /* le fil de la chaîne */
  .ladder__list::before {
    content: '';
    position: absolute;
    left: 0.95rem;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      to bottom,
      rgba(227, 155, 84, 0.7),
      rgba(227, 155, 84, 0.45) 50%,
      rgba(227, 155, 84, 0.2)
    );
  }

  .ladder__row {
    position: relative;
    opacity: max(0.55, calc(1 - (var(--dist, 0) * 0.012)));
  }

  .ladder__row::before {
    content: '';
    position: absolute;
    left: -0.9rem;
    top: 50%;
    width: 0.72rem;
    height: 1px;
    background: rgba(227, 155, 84, 0.28);
  }

  .ladder__row::after {
    content: '';
    position: absolute;
    left: -1.02rem;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background: #f0b983;
    box-shadow: 0 0 0 2px rgba(25, 15, 5, 0.9), 0 0 8px rgba(227, 155, 84, 0.7);
  }

  .ladder__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 2.4rem;
    padding: 0 0.5rem;
    border-radius: 9px;
    border: 1px solid transparent;
    color: var(--ink-dim);
    text-decoration: none;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .ladder__link img {
    image-rendering: pixelated;
    flex: none;
    border-radius: 5px;
    background: radial-gradient(circle at 50% 32%, #4c2f12, #1b1005 78%);
  }

  .ladder__link:hover,
  .ladder__link:focus-visible {
    background: rgba(248, 220, 192, 0.1);
    border-color: var(--edge-soft);
    color: var(--ink);
  }

  .ladder__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ladder__flag {
    flex: none;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffb2ac;
    border: 1px solid rgba(208, 69, 60, 0.5);
    background: rgba(208, 69, 60, 0.16);
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
    white-space: nowrap;
  }

  .ladder__id {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  /* le point de départ, épinglé en haut du cadre */
  .ladder__row--current {
    opacity: 1;
    position: sticky;
    top: 0;
    z-index: 2;
    background: linear-gradient(180deg, #35200c, #301d0a);
  }

  .ladder__row--current::before {
    background: rgba(227, 155, 84, 0.85);
    width: 0.85rem;
  }

  .ladder__row--current::after {
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    left: -1.13rem;
    background: #ffffff;
    box-shadow: 0 0 0 2px rgba(25, 15, 5, 0.95), 0 0 14px rgba(227, 155, 84, 1);
  }

  .ladder__link--current {
    height: 2.7rem;
    background: linear-gradient(180deg, #402811, #2f1c09);
    border-color: rgba(227, 155, 84, 0.6);
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 8px 20px -14px rgba(227, 155, 84, 0.9);
  }
  /* Dad's Note : le seul item qui ne peut pas etre reroll. */
  .ladder__row--blocked .ladder__link {
    background: linear-gradient(180deg, rgba(208, 69, 60, 0.16), rgba(208, 69, 60, 0.05));
    border-color: rgba(208, 69, 60, 0.45);
  }

  .ladder__row--blocked .ladder__name {
    color: #ffc9c3;
  }

  .ladder__row--blocked::after {
    background: #ff6a5e;
    box-shadow: 0 0 0 2px rgba(25, 15, 5, 0.9), 0 0 12px rgba(208, 69, 60, 0.9);
  }
</style>
