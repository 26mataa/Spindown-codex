---
import Base from '../../layouts/Base.astro';
import { formatId, QUALITY_COLORS, visibleItems } from '../../lib/chain';
import { url } from '../../lib/urls';

const pools = [...new Set(visibleItems.flatMap((i) => i.pools))].sort();
const types = ['passive', 'active', 'familiar'];
const qualities = [0, 1, 2, 3, 4];
---

<Base title="All items — Spindown Codex" description={`Every one of the ${visibleItems.length} collectibles in The Binding of Isaac: Repentance+.`}>
  <div class="wrap">
    <header class="head">
      <h1 data-i18n="items.title">All items</h1>
      <p class="muted" data-i18n="items.lede" data-i18n-args={JSON.stringify({ n: visibleItems.length })}>
        {visibleItems.length} collectibles, sorted by internal ID.
      </p>
    </header>

    <div class="shelf">
      <form class="filters" data-filters onsubmit="return false">
        <div class="field field--grow">
          <label for="f-name" data-i18n="items.name">Name</label>
          <input
            id="f-name"
            type="search"
            placeholder="Filter by English name…"
            autocomplete="off"
            data-f-name
            data-i18n-placeholder="items.namePlaceholder"
          />
        </div>

        <div class="field">
          <label for="f-type" data-i18n="items.type">Type</label>
          <select id="f-type" data-f-type>
            <option value="" data-i18n="items.all">all</option>
            {types.map((ty) => <option value={ty} data-i18n={`type.${ty}`}>{ty}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="f-quality" data-i18n="items.quality">Quality</label>
          <select id="f-quality" data-f-quality>
            <option value="" data-i18n="items.all">all</option>
            {qualities.map((q) => <option value={q}>{q}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="f-pool" data-i18n="items.pool">Pool</label>
          <select id="f-pool" data-f-pool>
            <option value="" data-i18n="items.all">all</option>
            {pools.map((p) => <option value={p}>{p}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="f-sort" data-i18n="items.sort">Sort</label>
          <select id="f-sort" data-f-sort>
            <option value="id" data-i18n="items.byId">ID</option>
            <option value="name" data-i18n="items.byName">Name</option>
            <option value="quality" data-i18n="items.byQuality">Quality</option>
          </select>
        </div>
      </form>

      <p class="count mono" data-count aria-live="polite">{visibleItems.length} items</p>

      <ul class="grid" data-grid>
        {
          visibleItems.map((item) => (
            <li
              class="cell"
              data-id={item.id}
              data-name={item.name.toLowerCase()}
              data-type={item.type}
              data-quality={item.quality ?? ''}
              data-pools={item.pools.join(' ')}
            >
              <a class="tile" href={url(`/items/${item.id}`)}>
                <span class="tile__art">
                  <img src={item.icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
                </span>
                <span class="tile__name">{item.name}</span>
                <span class="tile__meta mono">
                  <span>{formatId(item.id)}</span>
                  {item.quality !== null && (
                    <em style={`color:${QUALITY_COLORS[item.quality]}`}>Q{item.quality}</em>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="empty" hidden data-empty data-i18n="items.empty">No item matches these filters.</p>
    </div>
  </div>
</Base>

<script>
  import { t } from '../../i18n/runtime';

  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const grid = document.querySelector<HTMLUListElement>('[data-grid]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (form && grid) {
    const name = form.querySelector<HTMLInputElement>('[data-f-name]')!;
    const type = form.querySelector<HTMLSelectElement>('[data-f-type]')!;
    const quality = form.querySelector<HTMLSelectElement>('[data-f-quality]')!;
    const pool = form.querySelector<HTMLSelectElement>('[data-f-pool]')!;
    const sort = form.querySelector<HTMLSelectElement>('[data-f-sort]')!;

    const cells = [...grid.querySelectorAll<HTMLLIElement>('.cell')];
    const total = cells.length;

    const apply = () => {
      const q = name.value.trim().toLowerCase();
      const typeValue = type.value;
      const ql = quality.value;
      const p = pool.value;

      let shown = 0;
      for (const cell of cells) {
        const okName = !q || (cell.dataset.name ?? '').includes(q);
        const okType = !typeValue || cell.dataset.type === typeValue;
        const okQuality = ql === '' || cell.dataset.quality === ql;
        const okPool = !p || (cell.dataset.pools ?? '').split(' ').includes(p);
        const ok = okName && okType && okQuality && okPool;
        cell.hidden = !ok;
        if (ok) shown++;
      }

      if (count) {
        count.textContent =
          shown === total
            ? t('items.count', { n: total })
            : t('items.countFiltered', { shown, total });
      }
      if (empty) empty.hidden = shown !== 0;
    };

    const reorder = () => {
      const mode = sort.value;
      const sorted = [...cells].sort((a, b) => {
        if (mode === 'name') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
        if (mode === 'quality') {
          const qa = Number(a.dataset.quality || -1);
          const qb = Number(b.dataset.quality || -1);
          return qb - qa || Number(a.dataset.id) - Number(b.dataset.id);
        }
        return Number(a.dataset.id) - Number(b.dataset.id);
      });
      for (const cell of sorted) grid.appendChild(cell);
    };

    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
    sort.addEventListener('change', reorder);
    document.addEventListener('langchange', apply);
    apply();
  }
</script>

<style>
  .head {
    padding-block: 0.5rem 1.5rem;
  }

  .head p {
    max-width: 60ch;
    margin: 0;
  }

  /* Une seule plaque de verre : les items flottent dessus, ils ne sont plus
     séparés par des cadres individuels. */
  .shelf {
    padding: 0 0 1.5rem;
  }

  .filters {
    position: sticky;
    top: 3.9rem;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0.7rem 0.8rem;
    margin: -0.2rem -0.2rem 0.9rem;
    border-radius: var(--r-sm);
    background: linear-gradient(180deg, rgba(6, 30, 40, 0.94), rgba(6, 30, 40, 0.82));
    border: 1px solid var(--edge-soft);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 12px 26px -22px #000;
    backdrop-filter: blur(10px);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-width: 6.5rem;
  }

  .field--grow {
    flex: 1 1 13rem;
  }

  .field label {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .field input,
  .field select {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.38rem 0.55rem;
    border-radius: 8px;
    color: var(--ink);
    background: linear-gradient(180deg, rgba(2, 14, 20, 0.7), rgba(2, 14, 20, 0.5));
    border: 1px solid var(--edge-soft);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.45);
  }

  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: rgba(79, 216, 232, 0.6);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.45), 0 0 0 2px rgba(79, 216, 232, 0.35);
  }

  .count {
    margin: 0 0 0.7rem;
    font-size: 0.74rem;
    color: var(--ink-faint);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(176px, 1fr));
    gap: 0.3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    padding: 0.55rem 0.55rem 0.65rem;
    border-radius: 14px;
    border: 1px solid transparent;
    color: var(--ink);
    text-decoration: none;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .tile:hover,
  .tile:focus-visible {
    background: linear-gradient(180deg, rgba(190, 240, 250, 0.13), rgba(190, 240, 250, 0.04));
    border-color: var(--edge-soft);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 14px 26px -18px #000;
    transform: translateY(-2px);
  }

  .tile__art {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    background: radial-gradient(circle at 50% 32%, #11404e 0%, #061a23 62%, #031016 100%);
    box-shadow:
      inset 0 3px 16px rgba(0, 0, 0, 0.75),
      inset 0 0 0 1px rgba(190, 240, 250, 0.1),
      inset 0 -14px 22px -18px rgba(79, 216, 232, 0.6);
    overflow: hidden;
  }

  .tile__art img {
    image-rendering: pixelated;
    width: 62%;
    height: auto;
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.6));
    transition: transform 240ms var(--ease);
  }

  .tile:hover .tile__art img {
    transform: scale(1.1) translateY(-3px);
  }

  .tile__name {
    font-size: 0.86rem;
    line-height: 1.25;
    min-height: 2.1em;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .tile__meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--ink-faint);
    font-style: normal;
  }

  .tile__meta em {
    font-style: normal;
    font-weight: 700;
  }

  .empty {
    text-align: center;
    color: var(--ink-faint);
    padding: 3rem 0;
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    }
    .shelf {
      padding: 0 0 1rem;
    }
  }
</style>
