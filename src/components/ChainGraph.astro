---
/**
 * Graphe de la chaîne — disposition en colonne, focus + contexte.
 *
 * La relation Spindown est strictement linéaire : un seul successeur, un seul
 * prédécesseur. Une simulation de forces serait donc fausse (et illisible) ;
 * on utilise une colonne avec zoom/pan D3 et un recentrage au clic.
 */
import { visibleItems } from '../lib/chain';
import { url } from '../lib/urls';

const rows = [...visibleItems].reverse().map((i) => [i.id, i.name] as const);
const wallAfter = rows.findIndex((r) => r[0] === 668);
---

<div
  class="graph"
  id="chain-graph"
  data-break-after={wallAfter}
  data-start={723}
  aria-label="Spindown chain, from Mom's Ring down to The Sad Onion"
>
  <div class="graph__bar">
    <div class="graph__jump">
      <label class="visually-hidden" for="graph-jump" data-i18n="graph.jumpAria">Jump to an item ID</label>
      <input
        id="graph-jump"
        type="number"
        min="1"
        max="732"
        placeholder="ID…"
        data-jump
        data-i18n-placeholder="graph.jumpPlaceholder"
      />
      <button type="button" class="gbtn" data-jump-go data-i18n="graph.go">Go</button>
    </div>

    <p class="graph__hint mono" data-i18n="graph.hint">scroll to zoom · drag to pan · click a row</p>

    <div class="graph__zoom">
      <button type="button" class="gbtn" data-zoom-in aria-label="Zoom in">+</button>
      <button type="button" class="gbtn" data-zoom-out aria-label="Zoom out">−</button>
      <button type="button" class="gbtn" data-zoom-reset aria-label="Reset view">⌂</button>
    </div>
  </div>

  <div class="graph__canvas" data-canvas></div>

  <noscript>
    <p class="noscript">
      The interactive graph needs JavaScript. Every item is still listed on the
      <a href={url('/items')}>items page</a>.
    </p>
  </noscript>
</div>

<script type="application/json" id="graph-data" set:html={JSON.stringify(rows)}></script>

<script>
  import { select, zoom, zoomIdentity } from 'd3';
  import type { D3ZoomEvent } from 'd3';
  import { t } from '../i18n/runtime';
  import { url } from '../lib/urls';

  type ChainRow = [number, string];

  const host = document.getElementById('chain-graph')!;
  const canvas = host.querySelector<HTMLElement>('[data-canvas]')!;
  const dataEl = document.getElementById('graph-data')!;
  const rows = JSON.parse(dataEl.textContent!) as ChainRow[];
  const wallAfter = Number(host.dataset.breakAfter);
  const startId = Number(host.dataset.start);

  const STEP = 46;
  const PAD_X = 16;

  let width = canvas.clientWidth || 800;
  let height = canvas.clientHeight || 600;

  const svg = select(canvas)
    .append('svg')
    .attr('class', 'graph__svg')
    .attr('width', width)
    .attr('height', height)
    .attr('role', 'group')
    .attr('aria-label', 'Spindown chain');

  const g = svg.append('g');

  // Fond de la zone inatteignable depuis le haut (sous Dad's Note).
  const wallY = (wallAfter + 1) * STEP - STEP / 2;
  const bandHeight = rows.length * STEP - wallY;

  g.append('rect')
    .attr('class', 'deadzone')
    .attr('x', 0)
    .attr('y', wallY)
    .attr('width', width)
    .attr('height', Math.max(bandHeight, 0));

  const wall = g.append('g').attr('class', 'wall');

  wall
    .append('line')
    .attr('class', 'wall__line')
    .attr('x1', 0)
    .attr('x2', width)
    .attr('y1', wallY)
    .attr('y2', wallY);

  const wallLabel = wall
    .append('text')
    .attr('class', 'wall__label')
    .attr('x', width / 2)
    .attr('y', wallY - 10)
    .attr('text-anchor', 'middle');

  wallLabel.text(t('graph.wall'));

  document.addEventListener('langchange', () => {
    wallLabel.text(t('graph.wall'));
  });

  const nodes = g
    .append('g')
    .attr('class', 'nodes')
    .selectAll('g')
    .data(rows)
    .join('g')
    .attr('class', 'node')
    .attr('transform', (_d: ChainRow, i: number) => `translate(0,${i * STEP})`)
    .attr('data-id', (d: ChainRow) => d[0])
    .on('click', (_e: MouseEvent, d: ChainRow) => {
      location.href = url(`/items/${d[0]}`);
    })
    .on('keydown', (e: KeyboardEvent, d: ChainRow) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        location.href = url(`/items/${d[0]}`);
      }
    })
    .attr('tabindex', 0)
    .attr('role', 'link');

  nodes.append('rect').attr('class', 'node__bg').attr('width', width).attr('height', STEP).attr('rx', 3);

  nodes
    .append('image')
    .attr('class', 'node__icon')
    .attr('data-src', (d: ChainRow) => url(`/icons/${d[0]}.png`))
    .attr('x', PAD_X)
    .attr('y', 6)
    .attr('width', 34)
    .attr('height', 34);

  nodes
    .append('text')
    .attr('class', 'node__name')
    .attr('x', PAD_X + 46)
    .attr('dy', 28)
    .text((d: ChainRow) => d[1]);

  nodes
    .append('text')
    .attr('class', 'node__id')
    .attr('x', width - PAD_X)
    .attr('dy', 28)
    .attr('text-anchor', 'end')
    .text((d: ChainRow) => `#${String(d[0]).padStart(3, '0')}`);

  // Chargement paresseux des sprites : 717 PNG ne doivent pas partir d'un coup.
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as SVGImageElement;
        const src = el.dataset.src;
        if (src) {
          el.setAttribute('href', src);
          delete el.dataset.src;
        }
        io.unobserve(el);
      }
    },
    { root: canvas, rootMargin: '320px 0px' }
  );

  for (const img of nodes.select<SVGImageElement>('image').nodes()) {
    io.observe(img);
  }

  const z = zoom<SVGSVGElement, unknown>()
    .scaleExtent([0.18, 2.2])
    .on('zoom', (event: D3ZoomEvent<SVGSVGElement, unknown>) => {
      g.attr('transform', event.transform.toString());
      svg
        .classed('is-far', event.transform.k < 0.55)
        .classed('is-mid', event.transform.k >= 0.55 && event.transform.k < 0.85);
    });

  svg.call(z).on('dblclick.zoom', null);

  const indexOf = (id: number) => rows.findIndex((r) => r[0] === id);

  function centerOn(index: number, k = 1) {
    const y = index * STEP + STEP / 2;
    const t = zoomIdentity.translate(0, height / 2 - k * y).scale(k);
    svg.call(z.transform, t);
  }

  const jump = host.querySelector<HTMLInputElement>('[data-jump]')!;
  const jumpGo = host.querySelector<HTMLButtonElement>('[data-jump-go]')!;

  const doJump = () => {
    const index = indexOf(Number(jump.value));
    if (index >= 0) centerOn(index, 1);
  };

  jumpGo.addEventListener('click', doJump);
  jump.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      doJump();
    }
  });

  host.querySelector('[data-zoom-in]')?.addEventListener('click', () => {
    svg.call(z.scaleBy, 1.4);
  });
  host.querySelector('[data-zoom-out]')?.addEventListener('click', () => {
    svg.call(z.scaleBy, 1 / 1.4);
  });
  host.querySelector('[data-zoom-reset]')?.addEventListener('click', () => {
    centerOn(indexOf(startId), 1);
  });

  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      svg.attr('width', width).attr('height', height);
      nodes.select<SVGRectElement>('.node__bg').attr('width', width);
      nodes.select<SVGTextElement>('.node__id').attr('x', width - PAD_X);
      g.select<SVGRectElement>('.deadzone').attr('width', width);
      wall.select<SVGLineElement>('.wall__line').attr('x2', width);
      wall.select<SVGTextElement>('.wall__label').attr('x', width / 2);
    }, 120);
  });

  // Centre sur l'item demande (?focus=), sinon sur Spindown Dice elle-meme.
  const focusParam = new URLSearchParams(location.search).get('focus');
  const requestedIndex = focusParam === null ? -1 : indexOf(Number(focusParam));
  const startIndex = requestedIndex >= 0 ? requestedIndex : indexOf(startId);
  centerOn(startIndex >= 0 ? startIndex : 0, 1);
</script>

<style>
  .graph {
    display: flex;
    flex-direction: column;
    height: clamp(460px, 76vh, 820px);
    background: linear-gradient(180deg, #150e0e, #100a0a);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-warm);
  }

  .graph__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-raised) 80%, transparent);
    flex: none;
  }

  .graph__jump {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .graph__jump input {
    width: 5rem;
    font: inherit;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    padding: 0.15rem 0.35rem;
    color: var(--ink);
    background: var(--bg-card);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
  }

  .graph__hint {
    margin: 0;
    font-size: 0.7rem;
    color: var(--ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    text-align: center;
  }

  .graph__zoom {
    display: flex;
    gap: 0.2rem;
  }

  .gbtn {
    font: inherit;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
    line-height: 1;
    padding: 0.25rem 0.45rem;
    color: var(--ink-dim);
    background: var(--bg-card);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    cursor: pointer;
  }

  .gbtn:hover {
    color: var(--ink);
    border-color: var(--gold-dim);
  }

  .graph__canvas {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    /* les lignes s'effacent doucement en haut et en bas */
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 22px,
      #000 calc(100% - 22px),
      transparent 100%
    );
  }

  .graph__svg {
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .graph__svg:active {
    cursor: grabbing;
  }

  .noscript {
    padding: 1.5rem;
    color: var(--ink-dim);
  }

  /* --- éléments SVG (générés par D3, donc hors scoping Astro) --- */

  :global(.graph__svg text) {
    fill: var(--ink-dim);
    font-family: var(--font-body);
    font-size: 14px;
    pointer-events: none;
    user-select: none;
  }

  :global(.graph__svg .node__id) {
    fill: var(--ink-faint);
    font-family: ui-monospace, monospace;
    font-size: 11px;
  }

  :global(.graph__svg .node__bg) {
    fill: transparent;
    transition: fill 120ms linear;
  }

  :global(.graph__svg .node) {
    cursor: pointer;
    outline: none;
  }

  :global(.graph__svg .node:hover .node__bg),
  :global(.graph__svg .node:focus-visible .node__bg) {
    fill: rgba(212, 175, 55, 0.09);
  }

  :global(.graph__svg .node:focus-visible .node__name) {
    fill: var(--gold);
  }

  :global(.graph__svg .node__icon) {
    image-rendering: pixelated;
  }

  :global(.graph__svg .deadzone) {
    fill: rgba(179, 58, 58, 0.06);
  }

  :global(.graph__svg .wall__line) {
    stroke: var(--blood);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  :global(.graph__svg .wall__label) {
    fill: #dda3a3;
    font-size: 12px;
    letter-spacing: 0.02em;
    paint-order: stroke;
    stroke: #100a0a;
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  /* Vue intermédiaire : on garde les noms, on cache les IDs. */
  :global(.graph__svg.is-mid .node__id) {
    opacity: 0;
  }

  /* Vue éloignée : il ne reste que les icônes. */
  :global(.graph__svg.is-far text) {
    opacity: 0;
  }

  :global(.graph__svg.is-far .node__icon) {
    opacity: 0.85;
  }

  @media (max-width: 620px) {
    .graph__hint {
      display: none;
    }
  }
</style>
